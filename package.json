{
  "name": "pichost",
  "version": "1.3.0",
  "description": "Self-hosted image hosting for your NAS / home server — Nuxt admin UI, local disk or S3-compatible storage, server-side WebP compression, referer protection, Twikoo/EasyImage compatible.",
  "homepage": "https://github.com/O96u/PicHost#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/O96u/PicHost.git"
  },
  "bugs": {
    "url": "https://github.com/O96u/PicHost/issues"
  },
  "keywords": [
    "image-hosting",
    "self-hosted",
    "nas",
    "docker",
    "nuxt",
    "twikoo",
    "easyimage"
  ],
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.12.1",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node .output/server/index.mjs",
    "reset-password": "node server/cli/reset-password.mjs",
    "slider": "node server/cli/slider.mjs",
    "clear-domains": "node server/cli/clear-domains.mjs",
    "backup-export": "node server/cli/backup-export.mjs",
    "backup-restore": "node server/cli/backup-restore.mjs",
    "storage-sync": "node server/cli/storage-sync.mjs",
    "docs:prepare": "node docs-site/copy-screenshots.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs-site",
    "docs:build": "npm run docs:prepare && vitepress build docs-site",
    "docs:preview": "npm run docs:prepare && vitepress preview docs-site"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.876.0",
    "@iconify-json/lucide": "^1.2.114",
    "@nuxt/ui": "^4.9.0",
    "@nuxtjs/i18n": "^10.6.0",
    "cap-widget": "^0.1.57",
    "nuxt": "^4.4.8",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.1",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@types/node": "^22.15.0",
    "@types/tar": "^6.1.13",
    "eslint": "^10.6.0",
    "mermaid": "^11.17.2",
    "typescript": "^6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.3.5"
  }
}
